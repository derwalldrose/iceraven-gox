<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="6dp"
        android:background="#FFFFFF">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gox AI" android:textSize="19sp" android:textStyle="bold" android:textColor="#202124" />
            <TextView android:id="@+id/ai_model" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="220dp" android:ellipsize="end" android:singleLine="true" android:textSize="11sp" android:textColor="#7A8087" />
        </LinearLayout>
        <TextView android:id="@+id/ai_settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="设置" android:textColor="#202124" />
        <TextView android:id="@+id/ai_clear" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="清空" android:textSize="12sp" android:textColor="#5F6368" android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F2" />
    <CheckBox android:id="@+id/ai_search" android:layout_width="match_parent" android:layout_height="48dp" android:text="联网搜索（将问题发送给 Bing）" android:textColor="#202124" />
    <WebView android:id="@+id/ai_messages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFFFFF" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:id="@+id/ai_composer"
        android:orientation="horizontal" android:gravity="bottom" android:padding="10dp"
        android:background="#FFFFFF">
        <EditText android:id="@+id/ai_input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="64dp" android:maxLines="6" android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionNone" android:gravity="center_vertical|start" android:hint="问点什么…"
            android:background="@drawable/ai_composer_bg" android:paddingStart="16dp" android:paddingTop="11dp" android:paddingEnd="16dp" android:paddingBottom="11dp"
            android:textColor="#202124" android:textColorHint="#7A8087" android:textSize="15sp" />
        <TextView android:id="@+id/ai_send" android:layout_width="56dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_marginBottom="2dp"
            android:gravity="center" android:text="发送" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/ai_send_bg" />
    </LinearLayout>
</LinearLayout>
